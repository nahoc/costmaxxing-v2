{
  "name": "costmaxxing-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "core",
    "cli",
    "site",
    "mod"
  ],
  "scripts": {
    "test": "node --test \"core/test/*.test.ts\" \"cli/test/*.test.ts\" \"mod/test/*.test.ts\" \"site/test/*.test.ts\"",
    "typecheck": "tsc -p core && tsc -p cli && tsc -p site && tsc -p mod",
    "build": "npm run build -w cli && npm run build -w site && npm run build -w mod"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
