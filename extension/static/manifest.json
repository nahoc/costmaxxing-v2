{
  "manifest_version": 3,
  "name": "costmaxxing",
  "version": "1.0.1",
  "description": "How much can your claude.ai team save by moving from Anthropic to open-weight models? One click for Owners, all in your browser.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "costmaxxing",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://claude.ai/*",
    "https://models.dev/*"
  ]
}
